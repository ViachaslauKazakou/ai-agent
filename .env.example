GOOGLE_GMAIL_CLIENT_ID=
# Required for OAuth clients whose Google token endpoint requires it; keep secret.
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# OAuth Desktop app client ID; после заполнения: cargo run -- --gmail-login
LLM_PROVIDER=litellm
# OpenAI-compatible endpoint; requests go to ${LITELLM_BASE_URL}/chat/completions.
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=your-key
# For local Ollama use:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
MODEL=openai/gpt-4o-mini
WORKING_DIR=.
MAX_TOOL_ROUNDS=20
REQUEST_TIMEOUT_SECS=120
RUST_LOG=info

# Read-only Microsoft Graph email connector. Never put refresh tokens in this file.
# MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# Legacy/testing only; production uses `--graph-login` and the OS credential store.
# MICROSOFT_GRAPH_ACCESS_TOKEN=short-lived-access-token
# MICROSOFT_GRAPH_CLIENT_ID=your-public-entra-app-client-id
# MICROSOFT_GRAPH_TENANT=common
# MICROSOFT_GRAPH_SCOPE=offline_access Mail.Read User.Read

# Read-only Google Calendar and macOS Calendar.
# Google Calendar login: cargo run -- --google-calendar-login
